# =============================================================================
# Variables de entorno — Módulo de Valoración Docente con Controles Antisesgo
# IMPORTANTE: Identidad (Supabase) y Respuestas (Neon) nunca comparten BD.
# =============================================================================

ALLOWED_EMAIL_DOMAIN=udea.edu.co
MIN_RESPUESTAS_PUBLICACION=5

# BD de Control (Supabase - PostgreSQL): matrícula y emisión de tokens ciegos
CONTROL_DB_URL=postgresql://usuario:password@db.xxxx.supabase.co:5432/postgres

# BD de Respuestas Anónimas (Neon - PostgreSQL): ítems v0.2, pesos y agregados
RESPUESTAS_DB_URL=postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Ruta al clasificador calibrado entrenado fuera de línea
MODEL_PATH=../ml/artifacts/modelo_calidad_v1.joblib
